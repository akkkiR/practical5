<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/color_defaultbackground">

    <TextView
        android:id="@+id/textMainTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/main_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <ImageView
        android:id="@+id/imageMunicipalities"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/main_image_description"
        android:scaleType="fitCenter"
        android:src="@drawable/chinese_municipalities" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/label_municipality"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/editMunicipality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_municipality"
        android:imeOptions="actionGo"
        android:inputType="textCapWords"
        android:maxLines="1"
        android:singleLine="true"
        android:importantForAutofill="no" />
</LinearLayout>